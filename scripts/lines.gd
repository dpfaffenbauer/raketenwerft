extends RefCounted
## Was Mira sagt. Die Aufnahme dazu liegt in res://audio/voice/<id>.mp3 (Deutsch) bzw.
## res://audio/voice_en/<id>.mp3 (Englisch) – lokal erzeugt mit Qwen3-TTS, gleiche Stimme.

const T := preload("res://scripts/lang.gd")

## Text eines Satzes in der eingestellten Sprache (fehlt die Übersetzung: Deutsch).
static func text(id: String) -> String:
	if T.en() and LINES_EN.has(id):
		return LINES_EN[id]
	return LINES.get(id, id)

## Pfad der Aufnahme in der eingestellten Sprache.
static func voice_path(id: String) -> String:
	return ("res://audio/voice_en/%s.mp3" if T.en() else "res://audio/voice/%s.mp3") % id


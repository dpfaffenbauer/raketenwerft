; Pauls Raketenwerft – natives 3D-Spiel (Godot 4)

config_version=5

[application]

config/name="Raketenwerft"
config/description="Rakete bauen, Orbit, ISS und Mond – für Paul"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.03, 0.09, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
